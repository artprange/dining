generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PriceRange {
  CHEAP
  MODERATE
  EXPENSIVE
  FINE_DINING
}

enum RestaurantStatus {
  ACTIVE
  ARCHIVED
}

enum WishlistPriority {
  LOW
  NORMAL
  HIGH
}

model CuisineType {
  id          String       @id @default(uuid())
  name        String       @unique
  restaurants Restaurant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Tag {
  id          String       @id @default(uuid())
  name        String       @unique
  restaurants Restaurant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Restaurant {
  id               String           @id @default(uuid())
  name             String
  cuisineTypes     CuisineType[]
  tags             Tag[]
  priceRange       PriceRange?
  status           RestaurantStatus @default(ACTIVE)
  wishlistPriority WishlistPriority @default(NORMAL)
  address          String?
  neighborhood     String?
  city             String?
  notes            String?
  wouldReturn      Boolean?
  visits           Visit[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([city, neighborhood])
}

model Visit {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visitedAt    DateTime
  rating       Int
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, visitedAt])
}
